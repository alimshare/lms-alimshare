# ============================================================
# AlimShare LMS — Environment Variables
# Copy this file to .env.local and fill in the values
# ============================================================

# Database (Supabase)
# DATABASE_URL="postgresql://postgres.xxxx:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.xxxx:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Database (Local)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/alimshare_lms_db"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/alimshare_lms_db"


# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# Auth (NextAuth v5)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-here-run-openssl-rand-base64-32"

# Email (Resend)
RESEND_API_KEY="re_..."
EMAIL_FROM="noreply@alimshare.com"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="AlimShare LMS"
